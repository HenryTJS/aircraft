{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shm.local/skills/dfos/0.1.0",
  "title": "dfos skill contract",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gid"],
      "properties": {
        "gid": { "type": "string", "pattern": "^L1-[0-9]{2}$" },
        "base": { "enum": ["post", "bi"] }
      }
    },
    "output": {
      "type": "object",
      "required": ["skill", "version", "status", "data", "warnings", "evidence", "computation", "report"],
      "properties": {
        "skill": { "const": "dfos" },
        "version": { "const": "0.1.0" },
        "status": { "enum": ["ok", "unsupported", "not_found", "error"] },
        "data": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "computation": { "type": "object" },
        "report": { "type": "string" }
      }
    }
  }
}
